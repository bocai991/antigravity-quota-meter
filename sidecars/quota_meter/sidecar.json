{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "额度速览",
  "description": "查看 Antigravity 三个额度池（Gemini / Claude 与 GPT / Gemini 4 Argon）的剩余额度与重置时间。",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "额度",
    "views": [
      {
        "path": "/?mode=compact",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "额度"
      },
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "额度"
      }
    ]
  }
}
